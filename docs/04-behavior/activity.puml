@startuml activity
skinparam shadowing false
title Процесс онлайн-записи и проведения приёма (Appointment Lifecycle)

|Пациент (Patient)|
start
:Выбрать специализацию, врача и услугу;
:Выбрать свободный временной слот;

|Система (DentalLink)|
if (Слот свободен?) then (да)
  :Удержать слот на 10 минут\n(status = reserved, блокировка Redis);
else (нет, занят другим клиентом)
  :Сообщить «Слот только что был занят»;
  |Пациент (Patient)|
  :Выбрать другой слот;
  stop
endif

|Пациент (Patient)|
:Указать ФИО, телефон и причину обращения;

|Система (DentalLink)|
if (Данные корректны и удержание ещё действует?) then (да)
  :Создать Appointment (status = confirmed);
  :Закрепить TimeSlot (status = booked)\nи снять удержание;
else (нет)
  :Показать ошибку ввода или истечения удержания;
  |Пациент (Patient)|
  :Исправить данные или выбрать слот заново;
  stop
endif

|Пациент (Patient)|
:Увидеть экран подтверждения и ссылку на Telegram-бота;

|Система (DentalLink)|
:За 24 часа и за 2 часа отправить напоминание;

|Пациент (Patient)|
if (Пациент отвечает в Telegram?) then (подтверждает)
  :Нажать «Подтверждаю»;
  |Система (DentalLink)|
  :Отметить isConfirmedByPatient;
else (отменяет)
  :Нажать «Отменить запись»;
  |Система (DentalLink)|
  :Изменить статус записи на cancelled;
  :Освободить TimeSlot (status = free);
  stop
endif

|Пациент (Patient)|
if (Пациент пришёл к началу приёма?) then (да)
  |Администратор (Receptionist)|
  :Отметить статус arrived;
  |Врач-стоматолог (Doctor)|
  :Перевести приём в in_progress;
  :Провести диагностику и лечение;
  :Перевести приём в completed;
  |Администратор (Receptionist)|
  :Принять оплату на кассе;
  stop
else (нет)
  |Администратор (Receptionist)|
  :Зафиксировать статус no_show;
  stop
endif

@enduml
