@startuml use-case
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

title ИС «Онлайн-запись в стоматологию» (DentalLink): Диаграмма вариантов использования (Use Case)

actor "Пациент\n(patient)" as Patient
actor "Администратор\nресепшена\n(receptionist)" as Receptionist
actor "Врач-стоматолог\n(doctor)" as Doctor
actor "Управляющий\nклиники\n(admin)" as Admin

rectangle "DentalLink" {
  usecase "Войти в систему (персонал)" as UC1
  usecase "Просмотреть врачей и каталог услуг" as UC2
  usecase "Просмотреть онлайн-расписание и слоты" as UC3
  usecase "Забронировать временной слот" as UC4
  usecase "Заблокировать слот от накладок (Slot Hold)" as UC5
  usecase "Получить подтверждение и напоминание" as UC6
  usecase "Отметить прибытие пациента" as UC13
  usecase "Вести интерактивное расписание (Timeline)" as UC7
  usecase "Перенести или отменить запись" as UC8
  usecase "Просмотреть личный график приёмов" as UC9
  usecase "Изменить статус приёма (В процессе / Завершён)" as UC10
  usecase "Управлять графиком смен и кабинетов" as UC11
  usecase "Управлять справочником услуг и цен" as UC12
}

' Связи акторов с прецедентами
Patient --> UC2
Patient --> UC3
Patient --> UC4
Patient --> UC6
Patient --> UC8

Receptionist --> UC1
Receptionist --> UC2
Receptionist --> UC3
Receptionist --> UC7
Receptionist --> UC8
Receptionist --> UC13

Doctor --> UC1
Doctor --> UC9
Doctor --> UC10

Admin --> UC1
Admin --> UC11
Admin --> UC12
Admin --> UC7

' Отношения include и extend
UC4 ..> UC5 : <<include>>
UC7 ..> UC5 : <<include>>
UC4 ..> UC6 : <<include>>

note right of UC4
  ФТ-04: Онлайн-бронирование
  включает временную блокировку (UC5)
  для защиты от double-booking
end note

note right of UC6
  ФТ-07: после создания записи
  пациент получает ссылку на бота
  и последующие напоминания
end note

note right of UC8
  Отмена и перенос доступны
  пациенту и ресепшену напрямую,
  без привязки к сетке Timeline
end note

note right of UC13
  Ресепшен переводит запись
  в статус arrived до начала приёма
end note

@enduml
